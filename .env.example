# Google Apps Script web app URL for calendar (availability + create booking event).
# GET ?month=YYYY-MM for availability. POST JSON: { firstName, lastName, email, phone, instagram, date, startTime, endTime, notes, hours, quote }
# Use your script URL so busy times (class, etc.) are greyed out and bookings create events on your calendar.
NEXT_PUBLIC_BOOKING_API_URL=https://script.google.com/macros/s/AKfycbxit-ni-NnxXWQGXJiwN2NWwx_sNJI3cm5jYThnX41ZMaMT3C9CDYWdqkATyyqvTItR/exec

# Optional: Cal.com or Calendly iframe. When set and NEXT_PUBLIC_BOOKING_API_URL is not set, the booking section shows this embed instead of the inline calendar.
NEXT_PUBLIC_BOOKING_URL=

# Optional: Email confirmation. When set, a confirmation email is sent to the customer after a successful booking (includes address and duration).
# Example for Gmail: use an App Password (Google Account > Security > 2-Step Verification > App passwords). MAIL_FROM can be your Gmail address.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=The Studio <your@gmail.com>
